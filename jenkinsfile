pipeline{
  agent any{
  stages{
    stage('Checkout'){
      steps{
        git branch:'main',

          url:'https://github.com/dhariqanvar-7/Add_numbers.git'
      }
    }
    stage('compile'){
      steps{
        bat 'javac Addnumbers.java'
      }
    }
    stage('Execute'){
      steps{
        bat 'java Addnumbers'
      }
    }
  }
  post{
    success{
      echo 'Program Executed Succesfully'
    }
    failure{
      echo 'Program Execution Failed'
    }
    always{
      echo 'Pipeline Completed'
    }
  }
}
